# Copy to .env and fill in. Never commit .env.

# Model provider (any OpenAI-compatible API)
# Sail: https://api.sailresearch.com/v1   (key from the Sail dashboard; list models: GET /v1/models)
# Prime Intellect: https://api.pinference.ai/api/v1
LLM_BASE_URL=https://api.sailresearch.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Any long random string. Telegram sends it back in a header so we know requests are real.
TELEGRAM_WEBHOOK_SECRET=

# Neon Postgres connection string. If empty, Ridely keeps chats in memory (local only).
DATABASE_URL=

# minimal | standard | guardrails (see ridely/agent.py)
RIDELY_MODE=standard
